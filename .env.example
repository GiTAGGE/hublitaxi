# Admin moderation — https://hublitaxi.com/admin/reviews
ADMIN_REVIEW_PASSWORD=choose-a-strong-password
ADMIN_SESSION_SECRET=random-32-chars-openssl-rand-hex-32

# Rate-limit salt (random string, e.g. openssl rand -hex 32)
IP_HASH_SALT=

# Cloudflare Turnstile bot protection (https://dash.cloudflare.com/turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Netlify Blobs fallback (if auto-config fails on your site):
# NETLIFY_SITE_ID=     # Project ID from Netlify → Project configuration → General
# NETLIFY_AUTH_TOKEN=  # Personal access token from Netlify user settings

# Google Analytics 4 — Measurement ID from GA4 Admin → Data streams (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# No database — reviews are stored in Netlify Blobs on Netlify, or Workers KV
# when the REVIEWS binding is configured (wrangler.jsonc). Do not put secrets
# in wrangler.jsonc; use .dev.vars locally and Cloudflare dashboard secrets
# for the preview Worker. Copy .dev.vars.example → .dev.vars for OpenNext preview.
